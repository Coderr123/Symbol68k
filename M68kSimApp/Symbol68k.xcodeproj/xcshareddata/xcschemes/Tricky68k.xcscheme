   <ArchiveAction
      buildConfiguration = "Release"
      revealArchiveInOrganizer = "YES">
      <PostActions>
         <ExecutionAction
            ActionType = "Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title = "Create update archive"
               scriptText = "APP_PATH=&quot;${ARCHIVE_PATH}/Products/Applications/${FULL_PRODUCT_NAME}&quot;&#10;&#10;DMG_DIR_NAME=&quot;Release Archives&quot;&#10;#BUILD_ROOT=&quot;$(dirname &quot;${BUILD_DIR}&quot;)&quot;&#10;BUILD_ROOT=&quot;$(dirname &quot;${ARCHIVE_PATH}&quot;)&quot;&#10;&#10;DMG_DIR=&quot;${BUILD_ROOT}/${DMG_DIR_NAME}&quot;&#10;&#10;VERSION=&quot;${MARKETING_VERSION}&quot;&#10;&#10;SPARKLE_ARCHIVE=&quot;${DMG_DIR}/${PRODUCT_NAME}-${VERSION}.tar.bz2&quot;&#10;&#10;tar \&#10;    -cjf &quot;${SPARKLE_ARCHIVE}&quot; \&#10;    -C &quot;$(dirname &quot;${APP_PATH}&quot;)&quot; \&#10;    &quot;$(basename &quot;${APP_PATH}&quot;)&quot;&#10;">
               <EnvironmentBuildable>
                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "016CD1341A51A10E00D64892"
                     BuildableName = "Symbol68k.app"
                     ReferencedContainer = "container:Symbol68k.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
         </ExecutionAction>
         <ExecutionAction
            ActionType = "Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title = "Create DMG archive"
               scriptText = "#!/bin/bash&#10;&#10;set -Eeo pipefail&#10;&#10;# ============================================================================&#10;# CONFIGURATION&#10;# ============================================================================&#10;&#10;VOLUME_NAME=&quot;${FULL_PRODUCT_NAME%.app}&quot;&#10;DMG_DIR_NAME=&quot;Release Archives&quot;&#10;&#10;#BUILD_ROOT=&quot;$(dirname &quot;${BUILD_DIR}&quot;)&quot;&#10;BUILD_ROOT=&quot;$(dirname &quot;${ARCHIVE_PATH}&quot;)&quot;&#10;&#10;DMG_DIR=&quot;${BUILD_ROOT}/${DMG_DIR_NAME}&quot;&#10;&#10;#APP_PATH=&quot;${TARGET_BUILD_DIR}/${FULL_PRODUCT_NAME}&quot;&#10;APP_PATH=&quot;${ARCHIVE_PATH}/Products/Applications/${FULL_PRODUCT_NAME}&quot;&#10;&#10;VOLUME_NAME=&quot;${FULL_PRODUCT_NAME%.app}&quot;&#10;&#10;SOURCE_FOLDER=&quot;${DMG_DIR}/${VOLUME_NAME}&quot;&#10;DMG_PATH=&quot;${DMG_DIR}/${VOLUME_NAME}.dmg&quot;&#10;&#10;BACKGROUND_IMAGE=&quot;${PROJECT_DIR}/M68kSimApp/Installer Background.tiff&quot;&#10;&#10;WINDOW_X=&quot;${WINDOW_X:-200}&quot;&#10;WINDOW_Y=&quot;${WINDOW_Y:-120}&quot;&#10;WINDOW_WIDTH=&quot;${WINDOW_WIDTH:-660}&quot;&#10;WINDOW_HEIGHT=&quot;${WINDOW_HEIGHT:-498}&quot;&#10;&#10;ICON_SIZE=&quot;${ICON_SIZE:-128}&quot;&#10;TEXT_SIZE=&quot;${TEXT_SIZE:-16}&quot;&#10;&#10;APP_ICON_X=&quot;${APP_ICON_X:-100}&quot;&#10;APP_ICON_Y=&quot;${APP_ICON_Y:-190}&quot;&#10;&#10;APPLICATIONS_ICON_X=&quot;${APPLICATIONS_ICON_X:-330}&quot;&#10;APPLICATIONS_ICON_Y=&quot;${APPLICATIONS_ICON_Y:-190}&quot;&#10;&#10;DMG_FORMAT=&quot;${DMG_FORMAT:-UDZO}&quot;&#10;&#10;DMG_SIGN_IDENTITY=&quot;${DMG_SIGN_IDENTITY:-&quot;&quot;}&quot;&#10;NOTARY_PROFILE=&quot;${NOTARY_PROFILE:-&quot;&quot;}&quot;&#10;&#10;# ============================================================================&#10;# INTERNAL PATHS&#10;# ============================================================================&#10;&#10;APP_NAME=&quot;$(basename &quot;${APP_PATH}&quot;)&quot;&#10;&#10;WORK_DIR=&quot;$(mktemp -d &quot;${TMPDIR:-/tmp}/dmg-build.XXXXXX&quot;)&quot;&#10;RW_DMG=&quot;${WORK_DIR}/temporary.dmg&quot;&#10;&#10;MOUNT_DIR=&quot;&quot;&#10;DEVICE=&quot;&quot;&#10;&#10;mkdir -p &quot;${DMG_DIR}&quot;&#10;&#10;&#10;mkdir -p &quot;${DMG_DIR}&quot;&#10;&#10;# ============================================================================&#10;# CLEANUP&#10;# ============================================================================&#10;&#10;cleanup()&#10;{&#10;    if [[ -n &quot;${DEVICE}&quot; ]]; then&#10;        hdiutil detach &quot;${DEVICE}&quot; -quiet &gt;/dev/null 2&gt;&amp;1 || true&#10;    fi&#10;&#10;    rm -rf &quot;${WORK_DIR}&quot;&#10;}&#10;&#10;trap cleanup EXIT&#10;&#10;# ============================================================================&#10;# VALIDATE INPUT&#10;# ============================================================================&#10;&#10;if [[ ! -d &quot;${APP_PATH}&quot; ]]; then&#10;    exit 1&#10;fi&#10;&#10;if [[ ! -f &quot;${BACKGROUND_IMAGE}&quot; ]]; then&#10;    exit 1&#10;fi&#10;&#10;# ============================================================================&#10;# PREPARE SOURCE FOLDER&#10;# ============================================================================&#10;&#10;rm -rf &quot;${SOURCE_FOLDER}&quot;&#10;&#10;mkdir -p &quot;${SOURCE_FOLDER}&quot;&#10;&#10;ditto \&#10;    &quot;${APP_PATH}&quot; \&#10;    &quot;${SOURCE_FOLDER}/${APP_NAME}&quot;&#10;&#10;rm -f &quot;${SOURCE_FOLDER}/.DS_Store&quot;&#10;&#10;# ============================================================================&#10;# CREATE WRITABLE DMG&#10;# ============================================================================&#10;&#10;rm -f &quot;${DMG_PATH}&quot;&#10;rm -f &quot;${RW_DMG}&quot;&#10;&#10;hdiutil create \&#10;    -srcfolder &quot;${SOURCE_FOLDER}&quot; \&#10;    -volname &quot;${VOLUME_NAME}&quot; \&#10;    -fs &quot;HFS+&quot; \&#10;    -format UDRW \&#10;    &quot;${RW_DMG}&quot;&#10;&#10;CURRENT_BLOCKS=&quot;$(&#10;    hdiutil resize -limits &quot;${RW_DMG}&quot; |&#10;    awk &apos;NR == 1 { print $2 }&apos;&#10;)&quot;&#10;&#10;CURRENT_MB=&quot;$((CURRENT_BLOCKS / 2048))&quot;&#10;NEW_MB=&quot;$((CURRENT_MB + 32))&quot;&#10;&#10;hdiutil resize \&#10;    -size &quot;${NEW_MB}m&quot; \&#10;    &quot;${RW_DMG}&quot;&#10;&#10;# ============================================================================&#10;# MOUNT&#10;# ============================================================================&#10;&#10;ATTACH_OUTPUT=&quot;$(&#10;    hdiutil attach \&#10;        -readwrite \&#10;        -noverify \&#10;        -noautoopen \&#10;        -nobrowse \&#10;        &quot;${RW_DMG}&quot;&#10;)&quot;&#10;&#10;DEVICE=&quot;$(&#10;    printf &apos;%s\n&apos; &quot;${ATTACH_OUTPUT}&quot; |&#10;    awk &apos;/^\/dev\// {&#10;        print $1&#10;        exit&#10;    }&apos;&#10;)&quot;&#10;&#10;MOUNT_DIR=&quot;$(&#10;    printf &apos;%s\n&apos; &quot;${ATTACH_OUTPUT}&quot; |&#10;    awk -F &apos;\t&apos; &apos;/\/Volumes\// {&#10;        print $NF&#10;        exit&#10;    }&apos;&#10;)&quot;&#10;&#10;if [[ -z &quot;${DEVICE}&quot; || -z &quot;${MOUNT_DIR}&quot; ]]; then&#10;    exit 1&#10;fi&#10;&#10;# ============================================================================&#10;# APPLICATIONS LINK&#10;# ============================================================================&#10;&#10;rm -f &quot;${MOUNT_DIR}/Applications&quot;&#10;&#10;ln -s \&#10;    /Applications \&#10;    &quot;${MOUNT_DIR}/Applications&quot;&#10;&#10;# ============================================================================&#10;# BACKGROUND&#10;# ============================================================================&#10;&#10;BACKGROUND_FILE_NAME=&quot;$(basename &quot;${BACKGROUND_IMAGE}&quot;)&quot;&#10;&#10;mkdir -p &quot;${MOUNT_DIR}/.background&quot;&#10;&#10;ditto \&#10;    &quot;${BACKGROUND_IMAGE}&quot; \&#10;    &quot;${MOUNT_DIR}/.background/${BACKGROUND_FILE_NAME}&quot;&#10;&#10;# ============================================================================&#10;# FINDER LAYOUT&#10;# ============================================================================&#10;&#10;/usr/bin/osascript - \&#10;    &quot;${VOLUME_NAME}&quot; \&#10;    &quot;${MOUNT_DIR}&quot; \&#10;    &quot;${BACKGROUND_FILE_NAME}&quot; \&#10;    &quot;${APP_NAME}&quot; \&#10;    &quot;${WINDOW_X}&quot; \&#10;    &quot;${WINDOW_Y}&quot; \&#10;    &quot;${WINDOW_WIDTH}&quot; \&#10;    &quot;${WINDOW_HEIGHT}&quot; \&#10;    &quot;${ICON_SIZE}&quot; \&#10;    &quot;${TEXT_SIZE}&quot; \&#10;    &quot;${APP_ICON_X}&quot; \&#10;    &quot;${APP_ICON_Y}&quot; \&#10;    &quot;${APPLICATIONS_ICON_X}&quot; \&#10;    &quot;${APPLICATIONS_ICON_Y}&quot; &lt;&lt;&apos;APPLESCRIPT&apos;&#10;&#10;on run argv&#10;&#10;    set volumeName to item 1 of argv&#10;    set mountPath to item 2 of argv&#10;    set backgroundFileName to item 3 of argv&#10;    set appName to item 4 of argv&#10;&#10;    set windowX to (item 5 of argv) as integer&#10;    set windowY to (item 6 of argv) as integer&#10;    set windowWidth to (item 7 of argv) as integer&#10;    set windowHeight to (item 8 of argv) as integer&#10;&#10;    set iconSize to (item 9 of argv) as integer&#10;    set textSize to (item 10 of argv) as integer&#10;&#10;    set appIconX to (item 11 of argv) as integer&#10;    set appIconY to (item 12 of argv) as integer&#10;&#10;    set applicationsIconX to (item 13 of argv) as integer&#10;    set applicationsIconY to (item 14 of argv) as integer&#10;&#10;    set backgroundPath to mountPath &amp; &quot;/.background/&quot; &amp; backgroundFileName&#10;    &#10;    tell application &quot;Finder&quot;&#10;&#10;        set backgroundAlias to POSIX file backgroundPath as alias&#10;&#10;        tell disk volumeName&#10;&#10;            open&#10;&#10;            set finderWindow to container window&#10;&#10;            tell finderWindow&#10;                set current view to icon view&#10;                set toolbar visible to false&#10;                set statusbar visible to false&#10;                set bounds to {windowX, windowY, windowX + windowWidth, windowY + windowHeight}&#10;            end tell&#10;&#10;            set iconOptions to icon view options of finderWindow&#10;&#10;            tell iconOptions&#10;                set arrangement to not arranged&#10;                set icon size to iconSize&#10;                set text size to textSize&#10;                set background picture to backgroundAlias&#10;            end tell&#10;&#10;            set position of item appName to {appIconX, appIconY}&#10;            set position of item &quot;Applications&quot; to {applicationsIconX, applicationsIconY}&#10;            &#10;            set position of item &quot;.background&quot; to {0, 450}&#10;&#10;            set extension hidden of item appName to true&#10;&#10;            update without registering applications&#10;&#10;            delay 2&#10;&#10;        end tell&#10;&#10;    end tell&#10;&#10;end run&#10;&#10;APPLESCRIPT&#10;&#10;# ============================================================================&#10;# CLEAN MOUNTED VOLUME&#10;# ============================================================================&#10;&#10;chmod -Rf go-w &quot;${MOUNT_DIR}&quot; &gt;/dev/null 2&gt;&amp;1 || true&#10;&#10;rm -rf &quot;${MOUNT_DIR}/.fseventsd&quot; || true&#10;&#10;sync&#10;&#10;hdiutil detach \&#10;    &quot;${DEVICE}&quot; \&#10;&#10;DEVICE=&quot;&quot;&#10;MOUNT_DIR=&quot;&quot;&#10;&#10;# ============================================================================&#10;# COMPRESS FINAL DMG&#10;# ============================================================================&#10;&#10;if [[ &quot;${DMG_FORMAT}&quot; == &quot;UDZO&quot; ]]; then&#10;&#10;    hdiutil convert \&#10;        &quot;${RW_DMG}&quot; \&#10;        -format UDZO \&#10;        -imagekey zlib-level=9 \&#10;        -o &quot;${DMG_PATH}&quot;&#10;&#10;else&#10;&#10;    hdiutil convert \&#10;        &quot;${RW_DMG}&quot; \&#10;        -format &quot;${DMG_FORMAT}&quot; \&#10;        -o &quot;${DMG_PATH}&quot;&#10;&#10;fi&#10;&#10;# ============================================================================&#10;# SIGN FINAL DMG&#10;# ============================================================================&#10;&#10;if [[ -n &quot;${DMG_SIGN_IDENTITY}&quot; ]]; then&#10;&#10;    codesign \&#10;        --force \&#10;        --timestamp \&#10;        --sign &quot;${DMG_SIGN_IDENTITY}&quot; \&#10;        &quot;${DMG_PATH}&quot;&#10;&#10;    codesign \&#10;        --verify \&#10;        --deep \&#10;        --strict \&#10;        --verbose=2 \&#10;        &quot;${DMG_PATH}&quot;&#10;&#10;fi&#10;&#10;# ============================================================================&#10;# NOTARIZE FINAL DMG&#10;# ============================================================================&#10;&#10;if [[ -n &quot;${NOTARY_PROFILE}&quot; ]]; then&#10;&#10;    xcrun notarytool submit \&#10;        &quot;${DMG_PATH}&quot; \&#10;        --keychain-profile &quot;${NOTARY_PROFILE}&quot; \&#10;        --wait&#10;&#10;    xcrun stapler staple \&#10;        &quot;${DMG_PATH}&quot;&#10;&#10;    xcrun stapler validate \&#10;        &quot;${DMG_PATH}&quot;&#10;&#10;fi&#10;&#10;# ============================================================================&#10;# FINAL SECURITY VERIFICATION&#10;# ============================================================================&#10;&#10;if [[ -n &quot;${DMG_SIGN_IDENTITY}&quot; ]]; then&#10;&#10;    codesign \&#10;        --verify \&#10;        --deep \&#10;        --strict \&#10;        --verbose=2 \&#10;        &quot;${DMG_PATH}&quot;&#10;&#10;fi&#10;&#10;if [[ -n &quot;${NOTARY_PROFILE}&quot; ]]; then&#10;&#10;    spctl \&#10;        --assess \&#10;        --type open \&#10;        --context context:primary-signature \&#10;        --verbose=2 \&#10;        &quot;${DMG_PATH}&quot;&#10;&#10;fi&#10;&#10;#Cleanup. Delete source folder &#10;if [[ -n &quot;${SOURCE_FOLDER:-}&quot; &amp;&amp; -d &quot;${SOURCE_FOLDER}&quot; &amp;&amp; &quot;${SOURCE_FOLDER}&quot; == &quot;${DMG_DIR}/&quot;* ]]; then&#10;    rm -rf -- &quot;${SOURCE_FOLDER}&quot;&#10;fi&#10;">
               <EnvironmentBuildable>
                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "016CD1341A51A10E00D64892"
                     BuildableName = "Symbol68k.app"
                     ReferencedContainer = "container:Symbol68k.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
         </ExecutionAction>
      </PostActions>
   </ArchiveAction>
</Scheme>
